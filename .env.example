# Infraestrutura local (preencha antes de executar)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_LOG_LEVEL=info
EXECUTIONS_DATA_MAX_AGE=336

# Travas de seguranca: LIVE_MODE deve permanecer false em desenvolvimento
DEMO_MODE=true
LIVE_MODE=false

# Provedores intercambiaveis (mock nao faz chamadas externas)
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=
OPENAI_API_KEY=
IMAGE_PROVIDER=mock
IMAGE_MODEL=gpt-image-2
IMAGE_API_KEY=
ART_RENDERER=local
APPROVAL_AI_PROVIDER=mock
APPROVAL_AI_MODEL=gpt-5-mini

# Instagram API with Instagram Login - configurar somente na Fase 8.2
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0
SOCIAL_PUBLISH_PROVIDER=mock
INSTAGRAM_PUBLISH_ENABLED=false

# Buffer GraphQL API - chave pessoal somente no .env local
BUFFER_API_KEY=
BUFFER_API_URL=https://api.buffer.com
BUFFER_ACCOUNT_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_PUBLISH_ENABLED=false
BUFFER_DRY_RUN=true
PUBLICATION_WORKER_ENABLED=false
FIRST_LIVE_TARGET_USERNAME=
BUFFER_STATUS_POLL_ATTEMPTS=24
BUFFER_STATUS_POLL_SECONDS=5

# Immutable publication media storage (real values only in ignored .env)
MEDIA_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
MEDIA_UPLOAD_MAX_ATTEMPTS=3
MEDIA_UPLOAD_RETRY_SECONDS=2
PUBLISHED_MEDIA_RETENTION_DAYS=7

MEDIA_URL_TTL_MINUTES=30
MEDIA_DELIVERY_INTERNAL_KEY=
PUBLIC_MEDIA_BASE_URL=
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_RETRY_BASE_SECONDS=60

# Canva Connect API - OAuth, configurar somente na fase correspondente
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_BRAND_TEMPLATE_ID=
